<Window x:Class="MiniLauncherStyle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniLauncherStyle.Extensions"
        xmlns:vm="clr-namespace:MiniLauncherStyle.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="360" Width="700" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="White" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" Icon="favicon.ico">
    <Grid >
        <Grid.Background>
            <ImageBrush ImageSource="images\Background.png"/>
        </Grid.Background>
        <Grid x:Name="Head" HorizontalAlignment="Left" Height="46" Margin="0,0,0,0" VerticalAlignment="Top" Width="700"  >
            <Rectangle x:Name="Drag_Layout" HorizontalAlignment="Left" Height="46" Margin="0,0,0,0" Stroke="Black" VerticalAlignment="Top" Width="700" MouseDown="Drag_Layout_MouseDown">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="images\line top.png"/>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="Status_block" Margin="10,7,565,10">
                <Grid.Background>
                    <ImageBrush/>
                </Grid.Background>
                <Canvas x:Name="block" HorizontalAlignment="Left" Height="29" VerticalAlignment="Top" Width="150" Margin="0,0,-25,0">
                    <Canvas.Background>
                        <ImageBrush ImageSource="images\Block.png"/>
                    </Canvas.Background>
                </Canvas>
                <Rectangle x:Name="status_off" HorizontalAlignment="Left" Height="44" Margin="-4.965,-7.874,0,-7.126" Stroke="#00000000" VerticalAlignment="Top" Width="43" Visibility="{Binding StatusOffVisible, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="images\status_off.png"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="status_on" HorizontalAlignment="Left" Height="18" Margin="7.035,5.126,0,0" Stroke="#00000000" VerticalAlignment="Top" Width="19" RenderTransformOrigin="0.735,1.16" Visibility="{Binding StatusOnVisible, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="images\status_on.png"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock x:Name="status_label" HorizontalAlignment="Left" Height="19" Margin="38.035,6.46,-25,0" TextWrapping="Wrap" Text="{Binding ConnectionStatusText, FallbackValue='Сервер онлайн'}" VerticalAlignment="Top" Width="111.965" Foreground="{Binding StatusColor, Converter={StaticResource StringToColorBrush}}" FontFamily="Segoe UI Black"/>
            </Grid>
            <ComboBox x:Name="language" HorizontalAlignment="Right" Margin="0,0,80,0" IsEditable="False" FontSize="13" Foreground="#000EEC2D" Height="24" Width="45" SelectionChanged="LanguageSelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button x:Name="settings_btn" Style="{StaticResource ScaleButton}" Content="" HorizontalAlignment="Left" Height="22" Margin="633,10,0,0" VerticalAlignment="Top" Width="24" Click="Settings_btn_Click">
                <Button.Background>
                    <ImageBrush ImageSource="images\settingBtn.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="exit_btn" Style="{StaticResource ScaleButton}" Content="" HorizontalAlignment="Left" Height="22" Margin="664,10,0,0" VerticalAlignment="Top" Width="19" Click="Exit_btn_Click">
                <Button.Background>
                    <ImageBrush ImageSource="images\exitBtn.png"/>
                </Button.Background>
            </Button>
        </Grid>
        <Grid x:Name="Body" HorizontalAlignment="Left" Height="275" Margin="0,51,0,0" VerticalAlignment="Top" Width="700">
            <TextBlock x:Name="news_label" HorizontalAlignment="Left" Height="27" Margin="27,11,0,0" TextWrapping="Wrap" Text="{local:Loc Key=news}" VerticalAlignment="Top" Width="138.965" Foreground="White" FontSize="18" Visibility="{Binding NewsSectionVisible, Converter={StaticResource BoolToVisibility}}"/>
            <Grid x:Name="News_Section" Margin="10,50,411,23">
                <Grid x:Name="news1" Style="{StaticResource ScaleBlock}" HorizontalAlignment="Left" Height="62"  VerticalAlignment="Top" Width="269" MouseDown="News1_MouseDown" Visibility="{Binding News1Visible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Background>
                        <ImageBrush ImageSource="images\Block2.png"/>
                    </Grid.Background>
                    <TextBlock x:Name="news_head_1" HorizontalAlignment="Left" Height="22" Margin="11,7,0,0" TextWrapping="Wrap" Text="{Binding News1Head}" VerticalAlignment="Top" Width="237" Foreground="#FFC5E9F8" FontSize="14" />
                    <TextBlock x:Name="news_author_1" HorizontalAlignment="Left" Height="22" Margin="11,32,0,0" TextWrapping="Wrap" Text="{Binding News1Author}" VerticalAlignment="Top" Width="237" Foreground="#FFC5E9F8" FontSize="15" />
                    <Control x:Name="news_loader_1" Style="{StaticResource BusyAnimationStyle}" Margin="97.175,2,111.824,0" Width="60" Height="60" Visibility="{Binding News1LoaderVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Grid x:Name="news2" Style="{StaticResource ScaleBlock}" HorizontalAlignment="Left" Height="62" Margin="0,67,0,0"  VerticalAlignment="Top" Width="269" MouseDown="News2_MouseDown" Visibility="{Binding News2Visible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Background>
                        <ImageBrush ImageSource="images\Block2.png"/>
                    </Grid.Background>
                    <TextBlock x:Name="news_head_2" HorizontalAlignment="Left" Height="22" Margin="11,7,0,0" TextWrapping="Wrap" Text="{Binding News2Head}" VerticalAlignment="Top" Width="237" Foreground="#FFC5E9F8" FontSize="14" />
                    <TextBlock x:Name="news_author_2" HorizontalAlignment="Left" Height="22" Margin="11,32,0,0" TextWrapping="Wrap" Text="{Binding News2Author}" VerticalAlignment="Top" Width="237" Foreground="#FFC5E9F8" FontSize="15"/>
                    <Control x:Name="news_loader_2" Style="{StaticResource BusyAnimationStyle}" Margin="97.175,2,111.824,0" Width="60" Height="60" Visibility="{Binding News2LoaderVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Grid x:Name="news3"  Style="{StaticResource ScaleBlock}" HorizontalAlignment="Left" Height="62" Margin="0,134,0,0"  VerticalAlignment="Top" Width="269" MouseDown="News3_MouseDown" Visibility="{Binding News3Visible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Background>
                        <ImageBrush ImageSource="images\Block2.png"/>
                    </Grid.Background>
                    <TextBlock x:Name="news_head_3" HorizontalAlignment="Left" Height="22" Margin="11,7,0,0" TextWrapping="Wrap" Text="{Binding News3Head}" VerticalAlignment="Top" Width="237" Foreground="#FFC5E9F8" FontSize="14" />
                    <TextBlock x:Name="news_author_3" HorizontalAlignment="Left" Height="22" Margin="11,32,0,0" TextWrapping="Wrap" Text="{Binding News3Author}" VerticalAlignment="Top" Width="237" Foreground="#FFC5E9F8" FontSize="15" />
                    <Control x:Name="news_loader_3" Style="{StaticResource BusyAnimationStyle}" Margin="97.175,2,111.824,0" Width="60" Height="60" Visibility="{Binding News3LoaderVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
            <Grid x:Name="LoginBlock" Margin="475.5,40,13.5,38" HorizontalAlignment="Center" Width="211" VerticalAlignment="Center" IsEnabled="{Binding IsLoginBlockEnabled}">
                <Grid.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=LoginBlock}" Value="false">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" BeginTime="00:00:00">
                                                <SplineThicknessKeyFrame KeyTime="00:00:00" Value="475.5,40,13.5,38" />
                                                <SplineThicknessKeyFrame KeyTime="00:00:0.4" Value="700, 40,13.5,38" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" BeginTime="00:00:00">
                                                <SplineThicknessKeyFrame KeyTime="00:00:00" Value="700, 40,13.5,38" />
                                                <SplineThicknessKeyFrame KeyTime="00:00:0.4" Value="700, 40,13.5,38" />
                                                <SplineThicknessKeyFrame KeyTime="00:00:0.8" Value="475.5,40,13.5,38" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Rectangle x:Name="loginUIBlock"  Height="189" Stroke="#00000000" VerticalAlignment="Top" Width="211" Margin="0,0,0,-15">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="images\loginblock.png"/>
                    </Rectangle.Fill>
                </Rectangle>
                <ComboBox x:Name="login_input" Margin="10,49,10,116" IsEditable="True" SelectionChanged="Login_input_SelectionChanged" FontSize="13" Foreground="#000EEC2D" Height="24" Width="191" >
                </ComboBox>
                <TextBlock x:Name="auth_lable" HorizontalAlignment="Left" Height="27" Margin="45,11,0,0" TextWrapping="Wrap" Text="{local:Loc Key=auth}" VerticalAlignment="Top" Width="114.965" Foreground="White" FontSize="18"/>
                <PasswordBox x:Name="password_input" HorizontalAlignment="Left" Margin="10,86,0,0" VerticalAlignment="Top" Width="191" Height="24" FontSize="13" Foreground="#FF1EDA0B" />
                <CheckBox x:Name="save_checkbox" Content="{local:Loc Key=save_checkbox}" HorizontalAlignment="Left" Margin="9,116,0,0" VerticalAlignment="Top" Width="123.5" Background="#660C122E" BorderBrush="#FF23436C" Height="17.098" Foreground="White"/>
                <Button x:Name="play_btn" Style="{StaticResource PlayButton}" Content="" HorizontalAlignment="Left" Height="42.545" Margin="10,139.098,0,-7.643" VerticalAlignment="Top" Width="191" Click="Play_btn_Click" IsEnabled="{Binding IsLoginEnabled, FallbackValue=False}">
                    <Button.Background>
                        <ImageBrush ImageSource="images\play.png"/>
                    </Button.Background>
                </Button>
                <TextBlock HorizontalAlignment="Left" Height="18.833" Margin="132.5,117.265,0,0" TextWrapping="Wrap" Text="{local:Loc Key=register_btn}" VerticalAlignment="Top" Width="68.5" Foreground="White" MouseDown="TextBlock_MouseDown"/>

            </Grid>
            <Grid x:Name="Social" Margin="502,242,41,0">
                <Button x:Name="forum_btn" Style="{StaticResource ScaleButton}" Content="" HorizontalAlignment="Left" Height="33" VerticalAlignment="Top" Width="33" Click="Forum_btn_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="images\Forum.png"/>
                    </Button.Background>
                </Button>
                <Button x:Name="bd_btn" Style="{StaticResource ScaleButton}" Content="" HorizontalAlignment="Left" Height="33" Margin="38,0,0,0" VerticalAlignment="Top" Width="33" Click="Bd_btn_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="images\BD.png"/>
                    </Button.Background>
                </Button>
                <Button x:Name="vk_btn" Style="{StaticResource ScaleButton}" Content="" HorizontalAlignment="Left" Height="33" Margin="76,0,0,0" VerticalAlignment="Top" Width="33" Click="Vk_btn_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="images\VK.png"/>
                    </Button.Background>
                </Button>
                <Button x:Name="craft_btn" Style="{StaticResource ScaleButton}" Content="" HorizontalAlignment="Left" Height="30" Margin="114,0,0,0" VerticalAlignment="Top" Width="33" Click="Craft_btn_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="images\craft.png"/>
                    </Button.Background>
                </Button>
            </Grid>
            <TextBlock x:Name="menu_stat_btn" HorizontalAlignment="Left" Height="27" Margin="470,-42,0,0" TextWrapping="Wrap" Text="{local:Loc Key=stat}" VerticalAlignment="Top"  Width="95.543" Foreground="#FFC5E9F8" FontSize="18" MouseDown="Menu_stat_btn_MouseDown" IsEnabled="{Binding IsStatMenuEnabled}" TextDecorations="{Binding IsStatMenuUnderlined, Converter={StaticResource BoolToUnderline}}"/>
            <Grid x:Name="StatBlock" Margin="475.5,40,13.5,38" HorizontalAlignment="Center" Width="211" IsEnabled="{Binding IsStatBlockEnabled}">
                <Grid.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=StatBlock}" Value="false">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" BeginTime="00:00:00">
                                                <SplineThicknessKeyFrame KeyTime="00:00:00" Value="475.5, 40,13.5,38" />
                                                <SplineThicknessKeyFrame KeyTime="00:00:0.4" Value="700, 40,13.5,38" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" BeginTime="00:00:00">
                                                <SplineThicknessKeyFrame KeyTime="00:00:00" Value="700, 40,13.5,38" />
                                                <SplineThicknessKeyFrame KeyTime="00:00:0.4" Value="700, 40,13.5,38" />
                                                <SplineThicknessKeyFrame KeyTime="00:00:0.8" Value="475.5, 40,13.5,38" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Rectangle x:Name="loginUIBlock1"  Height="189" Stroke="#00000000" VerticalAlignment="Top" Width="211" Margin="0,0,0,-15">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="images/loginblock.png"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock HorizontalAlignment="Left" Height="27" Margin="45,11,0,0" TextWrapping="Wrap" Text="{local:Loc Key=chip_war_statistics}" VerticalAlignment="Top"  Width="125.965" Foreground="#FFC5E9F8" FontSize="18"/>
                <TextBlock x:Name="label_win_race" HorizontalAlignment="Left" Height="27" Margin="10,38,0,0" TextWrapping="Wrap" Text="{Binding WinRaceText}" VerticalAlignment="Top" Width="191" Foreground="White" FontSize="14"/>
                <TextBlock x:Name="label_ore_percent" HorizontalAlignment="Left" Height="27" Margin="10,61,0,0" TextWrapping="Wrap" Text="{Binding OrePercentText}" VerticalAlignment="Top" Width="191" Foreground="White" FontSize="14"/>
                <TextBlock HorizontalAlignment="Left" Height="27" Margin="59,87,0,0" TextWrapping="Wrap" Text="{local:Loc Key=time_to_chip_war}" VerticalAlignment="Top" Width="89.965" Foreground="#FFC5E9F8" FontSize="14"/>
                <TextBlock x:Name="chip_war_time_1" HorizontalAlignment="Left" Height="21" Margin="15,115,0,0" TextWrapping="Wrap" Text="{Binding ChipWarTime1, FallbackValue='6:00'}" VerticalAlignment="Top" Width="63.965" Foreground="White" FontSize="14"/>
                <TextBlock x:Name="chip_war_time_2" HorizontalAlignment="Left" Height="21" Margin="78.965,115,0,0" TextWrapping="Wrap" Text="{Binding ChipWarTime2, FallbackValue='14:00'}" VerticalAlignment="Top" Width="68.965" Foreground="White" FontSize="14"/>
                <TextBlock x:Name="chip_war_time_3" HorizontalAlignment="Left" Height="21" Margin="141.93,115,0,0" TextWrapping="Wrap" Text="{Binding ChipWarTime3, FallbackValue='22:00'}" VerticalAlignment="Top" Width="64.965" Foreground="White" FontSize="14"/>
                <TextBlock HorizontalAlignment="Left" Height="27" Margin="21,139,0,0" TextWrapping="Wrap" Text="{local:Loc Key=current_chip_percents}" VerticalAlignment="Top" Width="173" Foreground="#FFC5E9F8" FontSize="14"/>
                <TextBlock x:Name="acc_percent" HorizontalAlignment="Left" Height="21" Margin="12,164,0,0" TextWrapping="Wrap" Text="{Binding AccPercentText, FallbackValue='ACC-100%'}" VerticalAlignment="Top" Width="67.965" Foreground="White"/>
                <TextBlock x:Name="bcc_percent" HorizontalAlignment="Left" Height="21" Margin="76.965,164,0,0" TextWrapping="Wrap" Text="{Binding BccPercentText, FallbackValue='BCC-100%'}" VerticalAlignment="Top" Width="67.965" Foreground="White"/>
                <TextBlock x:Name="ccc_percent" HorizontalAlignment="Left" Height="21" Margin="141.93,164,0,0" TextWrapping="Wrap" Text="{Binding CccPercentText, FallbackValue='CCC-100%'}" VerticalAlignment="Top" Width="67.965" Foreground="White"/>

            </Grid>
            <TextBlock x:Name="menu_login_btn" HorizontalAlignment="Left" Height="27" Margin="420,-42,0,0" TextWrapping="Wrap" Text="{local:Loc Key=login_box}" VerticalAlignment="Top"  Width="44" Foreground="#FFC5E9F8" FontSize="18" TextDecorations="{Binding IsLoginMenuUnderlined, Converter={StaticResource BoolToUnderline}}" MouseDown="Menu_login_btn_MouseDown"/>
        </Grid>
        <Grid x:Name="Bottom" Margin="0,340
              ,0,0" Visibility="{Binding IsUpdateVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="22*"/>
                <ColumnDefinition Width="643*"/>
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="empty_proggres_bars" HorizontalAlignment="Left" Stroke="#00000000" VerticalAlignment="Top" Width="700" Height="19" Grid.ColumnSpan="4">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="images\Load.png"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="check_label" HorizontalAlignment="Left" Margin="4.833,-31.5,0,0" TextWrapping="Wrap" Text="{Binding CheckProgressText, FallbackValue='Проверка: (0/0)'}" VerticalAlignment="Top" Foreground="#FF0EB9F9" FontWeight="Bold" Grid.ColumnSpan="4" FontSize="10"/>
            <ProgressBar Style="{StaticResource BlueProgressBar}" x:Name="proggres_check" HorizontalAlignment="Left" Height="8" VerticalAlignment="Top" Width="700" Grid.ColumnSpan="4" Value="{Binding CheckProgressValue, FallbackValue=100}" Maximum="{Binding CheckProgressMax, FallbackValue=100}" Margin="0,1.334,0,0" />
            <ProgressBar Style="{StaticResource GreenProgressBar}" x:Name="proggres_apply" HorizontalAlignment="Left" Height="8" VerticalAlignment="Top" Width="700"  Grid.ColumnSpan="4" Margin="0,11.667,0,0" Value="{Binding ApplyProgressValue, FallbackValue=100}" Maximum="{Binding ApplyProgressMax, FallbackValue=100}">
            </ProgressBar>
            <TextBlock x:Name="apply_label" HorizontalAlignment="Left" Margin="4.833,-18.3,0,0" TextWrapping="Wrap" Text="{Binding ApplyProgressText, FallbackValue='Применение (0/0)'}" VerticalAlignment="Top" Foreground="#FF0EF90E" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="4"/>
        </Grid>
    </Grid>
</Window>
